    <!-- ─── Quaternion panel ─── -->
    <string name="quat_pro_message">Quaternion editing is a Pro feature. Values update live as you edit Euler / Matrix — upgrade to drag w/x/y/z directly.</string>
    <string name="quat_hamilton_desc">Hamilton convention: q = w + x i + y j + z k. Sliders edit raw components in -1..+1; the value is normalised to a unit quaternion before being applied.</string>
    <string name="quat_axis_angle_zero">axis = ?, angle = ? — draft norm is zero (move a slider)</string>
    <string name="quat_axis_angle_identity">"axis = (1, 0, 0), angle = 0.00°  (identity)"</string>
    <string name="quat_axis_angle">axis = (%1$+.3f, %2$+.3f, %3$+.3f), angle = %4$.2f°</string>
    <string name="inline_banner">"🔒  %1$s"</string>

    <!-- ─── Matrix panel ─── -->
    <string name="matrix_desc">Body→world rotation matrix R. v_world = R · v_body. Tap a cell to edit it via the slider; the matrix is re-orthonormalised on every change, so cells whose value is fully determined by the others may snap back as you drag.</string>
    <string name="matrix_det">"det(R) = %1$+.6f  (should be +1 for a proper rotation)"</string>
    <string name="matrix_editing">Editing m[%1$d, %2$d]</string>
    <string name="matrix_editing_value">"  =  %1$+.4f"</string>

